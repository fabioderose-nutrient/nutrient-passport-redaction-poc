# GdPicture.NET license key. Empty = evaluation mode (watermarked output).
GDPICTURE_LICENSE_KEY=
# Address the server listens on.
ASPNETCORE_URLS=http://localhost:5330
# Optional: folder with the OCR resources (ocrb.traineddata, eng.traineddata).
# Empty = runtimes/any/native next to the app, copied from the GdPicture.Resources NuGet package.
GdPicture__ResourceFolder=
