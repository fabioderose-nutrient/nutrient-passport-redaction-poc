<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PassportRedaction</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- GdPicture.API pulls the native runtimes for Windows, Linux and macOS. -->
    <PackageReference Include="GdPicture.API" Version="14.4.9" />
    <!-- OCR resources, including ocrb.traineddata for the MRZ. -->
    <PackageReference Include="GdPicture.Resources" Version="1.0.1" />
  </ItemGroup>

</Project>
